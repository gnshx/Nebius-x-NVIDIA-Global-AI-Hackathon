# =============================================================================
# RepoMedic Environment Variables
# Copy to .env and fill in your values. NEVER commit .env to version control.
# =============================================================================

# ---------------------------------------------------------------------------
# Application
# ---------------------------------------------------------------------------
APP_ENV=development           # development | production
APP_HOST=0.0.0.0
APP_PORT=8000
SECRET_KEY=change-me-in-production-use-openssl-rand-hex-32

# ---------------------------------------------------------------------------
# Database (PostgreSQL + pgvector)
# ---------------------------------------------------------------------------
DATABASE_URL=postgresql+asyncpg://repomedic:repomedic@localhost:5432/repomedic
DATABASE_POOL_SIZE=10
DATABASE_MAX_OVERFLOW=20

# ---------------------------------------------------------------------------
# Redis (Celery broker + SSE pub/sub)
# ---------------------------------------------------------------------------
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2

# ---------------------------------------------------------------------------
# GitHub App
# ---------------------------------------------------------------------------
GITHUB_APP_ID=
GITHUB_APP_NAME=repomedic
# Multi-line private key: base64-encode your .pem file, or use the path below
GITHUB_PRIVATE_KEY=
GITHUB_PRIVATE_KEY_PATH=
GITHUB_WEBHOOK_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# ---------------------------------------------------------------------------
# NVIDIA NIM API — LLM Inference (NVIDIA Nemotron 30B MoE)
# ---------------------------------------------------------------------------
NEBIUS_API_KEY=                      # NVIDIA NIM API Key (nvapi-...) or Nebius key
NEBIUS_BASE_URL=https://integrate.api.nvidia.com/v1

# NVIDIA Nemotron model names (configured for 30B A3B MoE with CoT reasoning)
NEMOTRON_PLANNER_MODEL=nvidia/nemotron-3.5-lightning-30b-a3b
NEMOTRON_CODER_MODEL=nvidia/nemotron-3.5-lightning-30b-a3b
NEMOTRON_FAST_MODEL=nvidia/nemotron-3.5-lightning-30b-a3b

# Embedding model for pgvector indexing
NEBIUS_EMBEDDING_MODEL=BAAI/bge-en-icl

# ---------------------------------------------------------------------------
# Execution Sandbox (Isolated Docker / Container Sandbox)
# ---------------------------------------------------------------------------
NEBIUS_SANDBOX_URL=                  # Optional remote sandbox endpoint (defaults to isolated Docker sandbox)
NEBIUS_SANDBOX_API_KEY=
NEBIUS_SANDBOX_TIMEOUT=300       # seconds
NEBIUS_SANDBOX_MAX_LOG_BYTES=51200  # 50KB

# ---------------------------------------------------------------------------
# Tavily Search
# ---------------------------------------------------------------------------
TAVILY_API_KEY=

# ---------------------------------------------------------------------------
# Agent Settings
# ---------------------------------------------------------------------------
MAX_FIX_ITERATIONS=3
MAX_CONTEXT_TOKENS=32000
SANDBOX_TIMEOUT_SECONDS=300

# ---------------------------------------------------------------------------
# Frontend
# ---------------------------------------------------------------------------
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ---------------------------------------------------------------------------
# Observability
# ---------------------------------------------------------------------------
LOG_LEVEL=INFO
OTEL_SERVICE_NAME=repomedic-api
OTEL_EXPORTER_OTLP_ENDPOINT=
