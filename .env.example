# =============================================================================
# RepoMedic Environment Variables
# Copy to .env and fill in your values. NEVER commit .env to version control.
# =============================================================================

# ---------------------------------------------------------------------------
# Application
# ---------------------------------------------------------------------------
APP_ENV=development           # development | production
APP_HOST=0.0.0.0
APP_PORT=8000
SECRET_KEY=change-me-in-production-use-openssl-rand-hex-32

# ---------------------------------------------------------------------------
# Database (PostgreSQL + pgvector)
# ---------------------------------------------------------------------------
DATABASE_URL=postgresql+asyncpg://repomedic:repomedic@localhost:5432/repomedic
DATABASE_POOL_SIZE=10
DATABASE_MAX_OVERFLOW=20

# ---------------------------------------------------------------------------
# Redis (Celery broker + SSE pub/sub)
# ---------------------------------------------------------------------------
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2

# ---------------------------------------------------------------------------
# GitHub App
# ---------------------------------------------------------------------------
GITHUB_APP_ID=
GITHUB_APP_NAME=repomedic
# Multi-line private key: base64-encode your .pem file, or use the path below
GITHUB_PRIVATE_KEY=
GITHUB_PRIVATE_KEY_PATH=
GITHUB_WEBHOOK_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# ---------------------------------------------------------------------------
# Nebius Token Factory — LLM Inference
# ---------------------------------------------------------------------------
NEBIUS_API_KEY=
NEBIUS_BASE_URL=https://api.studio.nebius.ai/v1

# NVIDIA Nemotron model names (configure via env — never hard-coded)
NEMOTRON_PLANNER_MODEL=nvidia/llama-3.1-nemotron-70b-instruct
NEMOTRON_CODER_MODEL=nvidia/llama-3.1-nemotron-70b-instruct
NEMOTRON_FAST_MODEL=nvidia/llama-3.1-nemotron-8b-instruct

# Embedding model for pgvector indexing
NEBIUS_EMBEDDING_MODEL=BAAI/bge-en-icl

# ---------------------------------------------------------------------------
# Nebius Token Factory — Sandbox Execution
# ---------------------------------------------------------------------------
NEBIUS_SANDBOX_URL=
NEBIUS_SANDBOX_API_KEY=
NEBIUS_SANDBOX_TIMEOUT=300       # seconds
NEBIUS_SANDBOX_MAX_LOG_BYTES=51200  # 50KB

# ---------------------------------------------------------------------------
# Tavily Search
# ---------------------------------------------------------------------------
TAVILY_API_KEY=

# ---------------------------------------------------------------------------
# Agent Settings
# ---------------------------------------------------------------------------
MAX_FIX_ITERATIONS=3
MAX_CONTEXT_TOKENS=32000
SANDBOX_TIMEOUT_SECONDS=300

# ---------------------------------------------------------------------------
# Frontend
# ---------------------------------------------------------------------------
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ---------------------------------------------------------------------------
# Observability
# ---------------------------------------------------------------------------
LOG_LEVEL=INFO
OTEL_SERVICE_NAME=repomedic-api
OTEL_EXPORTER_OTLP_ENDPOINT=
